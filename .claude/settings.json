{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(yarn*)",
      "Bash(pnpm*)",
      "Bash(./gradlew*)",
      "Bash(mvn*)",
      "Bash(cat*)",
      "Bash(ls*)",
      "Bash(grep*)",
      "Bash(find*)",
      "SlashCommand:/exec-wp",
      "SlashCommand:/exec-wp-batch",
      "Agent(wp-executor)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(npm install*)",
      "Bash(yarn add*)",
      "Bash(pnpm add*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(./.env*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "wp-executor",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/validate-wp-done.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/format-on-edit.sh"
          }
        ]
      }
    ]
  }
}
