<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime requirements para notarização Apple (mitigação R04). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Necessário para diálogos de arquivo nativos (open/save) usados em WP-08+. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- O Bartender imprime via CUPS no macOS. -->
    <key>com.apple.security.print</key>
    <true/>

    <!--
        offline-first: zero requisições de rede. Não declaramos
        com.apple.security.network.client.
    -->
</dict>
</plist>
