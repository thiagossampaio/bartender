---
/**
 * Stack de ícones de SO. Renderiza os 4 SVGs e mostra apenas aquele cujo
 * `data-os-icon` casa com o `data-current-os` do ancestral mais próximo
 * (via CSS de irmãos). Sem JS para alternar — apenas trocar o data-attr.
 */
import OsIcon from './OsIcon.astro';

interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className = '' } = Astro.props;
---

<span class={`os-icon-stack inline-flex items-center justify-center ${className}`} aria-hidden="true">
  <span data-os-icon="win"><OsIcon os="win" size={size} /></span>
  <span data-os-icon="mac"><OsIcon os="mac" size={size} /></span>
  <span data-os-icon="linux-deb"><OsIcon os="linux-deb" size={size} /></span>
  <span data-os-icon="linux-appimage"><OsIcon os="linux-appimage" size={size} /></span>
</span>

<style is:global>
  /* Por padrão, ícone Windows visível (SSR fallback) e demais ocultos. */
  .os-icon-stack [data-os-icon] {
    display: none;
  }
  [data-current-os='win'] .os-icon-stack [data-os-icon='win'],
  [data-current-os='mac'] .os-icon-stack [data-os-icon='mac'],
  [data-current-os='linux-deb'] .os-icon-stack [data-os-icon='linux-deb'],
  [data-current-os='linux-appimage'] .os-icon-stack [data-os-icon='linux-appimage'],
  :not([data-current-os]) .os-icon-stack [data-os-icon='win'] {
    display: inline-flex;
  }
</style>
