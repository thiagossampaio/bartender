}
{
  os === 'mac' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M16.4 3.1c0 1-.4 2-1.1 2.7-.7.8-1.8 1.3-2.8 1.3-.1-1 .4-2 1-2.7.8-.8 1.9-1.3 2.9-1.3ZM20 17.3c-.5 1.2-.8 1.7-1.5 2.7-1 1.5-2.4 3.4-4.1 3.4-1.5 0-1.9-1-3.9-1-2 0-2.5 1-4 1-1.7 0-3-1.7-4-3.2C-.3 16.3-.6 11 1.4 8c1.4-2.1 3.5-3.3 5.6-3.3 2 0 3.3 1.1 4.9 1.1 1.6 0 2.6-1.1 4.9-1.1 1.8 0 3.6 1 4.9 2.7-4.3 2.4-3.6 8.5-1.7 9.9Z" />
