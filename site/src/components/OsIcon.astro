---
/**
 * Glifos de SO em ink. Renderizados como SVG inline para evitar requisições.
 */
interface Props {
  os: 'win' | 'mac' | 'linux-deb' | 'linux-appimage' | 'linux';
  size?: number;
  class?: string;
}
const { os, size = 28, class: className = '' } = Astro.props;
---

{
  os === 'win' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M3 5.2 10.5 4v7.4H3V5.2Zm0 7.4h7.5V20L3 18.8v-6.2Zm8.5-8.7L21 2.5v9.1h-9.5V3.9Zm0 9.1H21V21.5l-9.5-1.3V13Z" />
