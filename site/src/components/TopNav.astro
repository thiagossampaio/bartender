---
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import { useTranslations, pagePath, docPath } from '../i18n/utils';
import { REPO_URL, buildTimeVersion } from '../lib/releases';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const version = buildTimeVersion();

const links = [
  { label: t('nav.features'), href: pagePath(locale, 'features') },
  { label: t('nav.docs'), href: docPath(locale) },
  { label: t('nav.download'), href: pagePath(locale, 'download') },
];
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center gap-3 md:gap-6">
    <a
      href={pagePath(locale, 'home')}
      class="flex items-center gap-2 text-ink shrink-0"
      aria-label="Bartender"
    >
      <Logo size={28} class="text-ink" />
      <span class="display-sm leading-none">Bartender</span>
    </a>

    <nav aria-label="Primary" class="ml-auto hidden md:flex items-center gap-6">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="caption text-body hover:text-ink transition-colors text-[15px] font-medium"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="caption text-body hover:text-ink transition-colors text-[15px] font-medium"
      >
        {t('nav.github')}
      </a>
    </nav>

    <div class="flex items-center gap-2 md:gap-3 ml-auto md:ml-0 shrink-0">
      <span
        class="hidden lg:inline-flex caption-uppercase text-muted"
        data-version-badge
      >
        v{version}
      </span>
      <LangSwitcher currentLocale={locale} />
      <a
        href={Astro.url.pathname.includes('download') ? '#all-downloads' : pagePath(locale, 'download')}
        class="btn-pill btn-pill-primary px-4"
      >
        <span class="hidden sm:inline">{t('cta.download')}</span>
        <span class="sm:hidden" aria-label={t('cta.download')}>↓</span>
      </a>
    </div>
  </div>

  <!-- Mobile nav: linhas de navegação visíveis abaixo do header em telas pequenas -->
  <nav aria-label="Mobile" class="md:hidden border-t border-hairline">
    <div class="container-page flex gap-5 overflow-x-auto py-2.5 text-[14px] font-medium">
      {
        links.map((l) => (
          <a href={l.href} class="text-body hover:text-ink whitespace-nowrap">
            {l.label}
          </a>
        ))
      }
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-body hover:text-ink whitespace-nowrap"
      >
        {t('nav.github')}
      </a>
    </div>
  </nav>
</header>
