---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientOrb from '../components/GradientOrb.astro';
import { useTranslations, pagePath } from '../i18n/utils';
const locale = 'en-US' as const;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title="404 · Bartender" description="Page not found.">
  <section class="relative overflow-hidden">
    <GradientOrb variant="rose" size="xl" position="-top-40 -right-40" opacity={0.45} />
    <GradientOrb variant="lavender" size="lg" position="-bottom-32 -left-32" opacity={0.4} />
    <div class="container-page section-pad relative flex flex-col items-center text-center gap-6">
      <p class="caption-uppercase text-muted">404</p>
      <h1 class="display-mega text-ink">{t('404.title')}</h1>
      <p class="body-md text-body max-w-md">{t('404.body')}</p>
      <a href={pagePath(locale, 'home')} class="btn-pill btn-pill-primary btn-pill-lg">
        {t('cta.back.home')}
      </a>
    </div>
  </section>
</BaseLayout>
