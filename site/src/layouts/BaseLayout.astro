---
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getLocalizedHref } from '../i18n/utils';
import { defaultLocale, locales, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
}
const { locale, title, description, ogImage } = Astro.props;
const t = useTranslations(locale);

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// hreflang alternates
const alternates = locales.map((loc) => ({
  hreflang: loc,
  href: new URL(getLocalizedHref(Astro.url, loc), Astro.site).toString(),
}));
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getLocalizedHref(Astro.url, defaultLocale), Astro.site).toString()}
    />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#f5f5f5" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-canvas text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:btn-pill focus:btn-pill-primary"
    >
      {locale === 'pt-BR' ? 'Ir para o conteúdo' : 'Skip to content'}
    </a>

    <TopNav locale={locale} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import '../scripts/live-version';
      import '../scripts/detect-os';
    </script>
  </body>
</html>
